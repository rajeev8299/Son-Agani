# ==============================================================================
# GOOGLE BUSINESS PROFILE & PLACES API CONFIGURATION (SON AGNI SECURITIES)
# ==============================================================================
# Copy this file to .env.local or set these variables in your deployment environment.
# NEVER commit .env.local or real secrets to source control.

# Option A: Google Places API (New) / Client Key (For Place Details & Reviews retrieval)
# Enabled in Google Cloud Console -> APIs & Services -> Google Places API (New)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_PLACE_ID=

# Option B: Google Business Profile API (OAuth 2.0 / Server-to-Server Sync)
# Enabled in Google Cloud Console -> My Business Account Management API & Business Information API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Official Google Review Direct Links (for opening review modal & full profile on Google)
# Generate from Google Business Profile Manager -> "Ask for reviews"
VITE_GOOGLE_WRITE_REVIEW_URL=https://search.google.com/local/writereview?placeid=
VITE_GOOGLE_READ_REVIEWS_URL=https://search.google.com/local/reviews?placeid=

